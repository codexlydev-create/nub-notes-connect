# Copy this to .env and fill in real values
PORT=5000
CLIENT_ORIGIN=http://localhost:8080
MONGODB_URI=mongodb://127.0.0.1:27017/noteshare
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Gmail account used to send OTP / contact-form emails.
# GMAIL_APP_PASSWORD must be a Google App Password (not your real password).
# https://myaccount.google.com/apppasswords
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where contact-form messages are delivered. Defaults to GMAIL_USER if blank.
CONTACT_INBOX=

# Max upload size in MB
MAX_UPLOAD_MB=25